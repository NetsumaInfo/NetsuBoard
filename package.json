{
  "name": "netsuboard",
  "private": true,
  "version": "0.4.2",
  "license": "AGPL-3.0-only",
  "author": "Haim Faraj",
  "repository": {
    "type": "git",
    "url": "https://github.com/NetsumaInfo/NetsuBoard.git"
  },
  "bugs": {
    "url": "https://github.com/NetsumaInfo/NetsuBoard/issues"
  },
  "homepage": "https://github.com/NetsumaInfo/NetsuBoard#readme",
  "type": "module",
  "description": "NetsuBoard — mood board standalone (Tauri + core Node) : images, vidéos et embeds sur un canvas infini, upscale par shaders GPU",
  "main": "core/server.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "core": "node core/server.js",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "check:core": "tsc -p tsconfig.core.json",
    "test:hardware": "node --test test/hardware.test.cjs",
    "test:preview": "node --test test/preview-generation.test.cjs",
    "test:config-backend": "node --test test/config-backend.test.cjs",
    "test:packaging": "node --test test/packaging.test.cjs",
    "test:setup": "node --test test/setup-selection.test.cjs",
    "test:bug-report": "node --test test/bug-report.test.cjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "package": "powershell -ExecutionPolicy Bypass -File scripts/build.ps1",
    "update:manifest": "node scripts/create-update-manifest.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@convex-dev/better-auth": "^0.12.5",
    "@fontsource-variable/caveat": "^5.2.8",
    "@fontsource-variable/inter": "^5.2.8",
    "@material/material-color-utilities": "^0.4.0",
    "@number-flow/react": "^0.6.0",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "better-auth": "^1.6.28",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.44.0",
    "i18next": "^26.3.6",
    "lucide-react": "^0.460.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.9",
    "shadcn": "^4.11.0",
    "simple-icons": "^16.24.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.3",
    "@types/node": "^25.9.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "tailwindcss": "^4.3.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
