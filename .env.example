# NetsuBoard — renderer variables (Vite). Copy this file to `.env.local`, then fill it in.
# Both values are printed by `npx convex dev`. NEVER commit `.env.local`.
#
# Leaving them empty is a supported state: the app then boots with no sign-in gate and bug reports
# fall back to the direct Discord webhook (or to a local file). See `docs/distribution.md`.
#
# The SECRETS (Discord client id/secret, BUG_WEBHOOK) do NOT belong here — they are set on the
# Convex deployment, from the dashboard or with `npx convex env set`, and never ship in the app.

# Convex deployment URL (reactive WebSocket) — ends in .convex.cloud
VITE_CONVEX_URL=

# Convex site URL (Better Auth HTTP routes and the bug relay) — ends in .convex.site
VITE_CONVEX_SITE_URL=
